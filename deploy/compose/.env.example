# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
SESSION_SECRET=replace-with-output-of-make-env
API_KEY_PEPPER=replace-with-output-of-make-env
LOCAL_MASTER_KEY=replace-with-output-of-make-env
RUNTIME_TOKEN_SECRET=replace-with-output-of-make-env
INTERNAL_API_TOKEN=replace-with-output-of-make-env
TURN_SECRET=replace-with-output-of-make-env
VOS_DEMO_PASSWORD=replace-with-output-of-make-env

# Optional overrides
# VOS_LOG_LEVEL=INFO
# VOS_REDIS_URL=              (empty: run the whole stack without Redis)
# VOS_WHISPER_DOWNLOAD=tiny,base,small
# VOS_WHISPER_PRELOAD=base
# VOS_MAX_SESSIONS=8
# VOS_WEB_PORT=4510
# VOS_API_PORT=4530
# VOS_RUNTIME_PORT=4535
# VOS_SPEECH_PORT=4537
# VOS_MOCK_PORT=4550
# VOS_PG_PORT=4542
# VOS_REDIS_PORT=4579
# VOS_TURN_PORT=4578
# VOS_FLOCI_PORT=4566
